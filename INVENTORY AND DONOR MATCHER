
import java.util.ArrayList;
import java.util.Scanner;

class Donor {
    String name;
    int age;
    String bloodGroup;
    String phone;

    Donor(String name, int age, String bloodGroup, String phone) {
        this.name = name;
        this.age = age;
        this.bloodGroup = bloodGroup;
        this.phone = phone;
    }

    void display() {
        System.out.println("Name: " + name
                + " | Age: " + age
                + " | Blood Group: " + bloodGroup
                + " | Phone: " + phone);
    }
}

public class BLOOD BANK INVENTORYANDDONORMATCHER
 {

    static Scanner sc = new Scanner(System.in);
    static ArrayList<Donor> donors = new ArrayList<>();

    static String[] bloodGroups = {
        "A+", "A-", "B+", "B-",
        "AB+", "AB-", "O+", "O-"
    };

    static int[] stock = new int[8];

    // Check whether a blood group is valid
    static boolean isValidBloodGroup(String group) {
        for (String bg : bloodGroups) {
            if (bg.equals(group)) {
                return true;
            }
        }
        return false;
    }

    // Find the index of a blood group
    static int getIndex(String group) {
        for (int i = 0; i < bloodGroups.length; i++) {
            if (bloodGroups[i].equals(group)) {
                return i;
            }
        }
        return -1;
    }

    // Check red blood cell donor compatibility
    static boolean isCompatible(String donor, String recipient) {
        switch (recipient) {
            case "A+":
                return donor.equals("A+") || donor.equals("A-")
                    || donor.equals("O+") || donor.equals("O-");

            case "A-":
                return donor.equals("A-") || donor.equals("O-");

            case "B+":
                return donor.equals("B+") || donor.equals("B-")
                    || donor.equals("O+") || donor.equals("O-");

            case "B-":
                return donor.equals("B-") || donor.equals("O-");

            case "AB+":
                return true;

            case "AB-":
                return donor.equals("A-") || donor.equals("B-")
                    || donor.equals("AB-") || donor.equals("O-");

            case "O+":
                return donor.equals("O+") || donor.equals("O-");

            case "O-":
                return donor.equals("O-");

            default:
                return false;
        }
    }

    // Add a new donor
    static void addDonor() {
        System.out.print("Enter donor name: ");
        String name = sc.nextLine().trim();

        System.out.print("Enter donor age: ");
        int age = readInt();

        if (name.isEmpty() || age < 18 || age > 100) {
            System.out.println("Invalid name or age.");
            return;
        }

        System.out.print("Enter blood group (A+, A-, B+, B-, AB+, AB-, O+, O-): ");
        String group = sc.nextLine().trim().toUpperCase();

        if (!isValidBloodGroup(group)) {
            System.out.println("Invalid blood group!");
            return;
        }

        System.out.print("Enter phone number: ");
        String phone = sc.nextLine().trim();

        donors.add(new Donor(name, age, group, phone));

        System.out.println("Donor registered successfully!");
    }

    // Display all donors
    static void viewDonors() {
        if (donors.isEmpty()) {
            System.out.println("No donors registered yet.");
            return;
        }

        System.out.println("\n--- REGISTERED DONORS ---");
        for (Donor donor : donors) {
            donor.display();
        }
    }

    // Add blood units to inventory
    static void addBloodStock() {
        System.out.print("Enter blood group: ");
        String group = sc.nextLine().trim().toUpperCase();

        int index = getIndex(group);

        if (index == -1) {
            System.out.println("Invalid blood group!");
            return;
        }

        System.out.print("Enter number of units to add: ");
        int units = readInt();

        if (units <= 0) {
            System.out.println("Units must be greater than zero.");
            return;
        }

        stock[index] += units;
        System.out.println("Blood stock updated successfully!");
    }

    // Display available blood inventory
    static void viewInventory() {
        System.out.println("\n--- BLOOD BANK INVENTORY ---");

        for (int i = 0; i < bloodGroups.length; i++) {
            System.out.println(bloodGroups[i] + " : "
                    + stock[i] + " units");
        }
    }

    // Search donors compatible with a recipient
    static void findDonors() {
        System.out.print("Enter recipient blood group: ");
        String recipient = sc.nextLine().trim().toUpperCase();

        if (!isValidBloodGroup(recipient)) {
            System.out.println("Invalid blood group!");
            return;
        }

        boolean found = false;

        System.out.println("\n--- POTENTIAL COMPATIBLE DONORS ---");

        for (Donor donor : donors) {
            if (isCompatible(donor.bloodGroup, recipient)) {
                donor.display();
                found = true;
            }
        }

        if (!found) {
            System.out.println("No matching donors found.");
        }
    }

    // Request blood from inventory
    static void requestBlood() {
        System.out.print("Enter recipient blood group: ");
        String recipient = sc.nextLine().trim().toUpperCase();

        if (!isValidBloodGroup(recipient)) {
            System.out.println("Invalid blood group!");
            return;
        }

        System.out.print("Enter required units: ");
        int units = readInt();

        if (units <= 0) {
            System.out.println("Units must be greater than zero.");
            return;
        }

        int[] compatibleIndexes = new int[bloodGroups.length];
        int count = 0;
        int available = 0;

        for (int i = 0; i < bloodGroups.length; i++) {
            if (isCompatible(bloodGroups[i], recipient)) {
                compatibleIndexes[count++] = i;
                available += stock[i];
            }
        }

        if (available < units) {
            System.out.println("Insufficient compatible stock.");
            System.out.println("Available units: " + available);
            return;
        }

        // Use exact recipient group stock first,
        // then other compatible groups.
        int exactIndex = getIndex(recipient);
        int remaining = units;

        int use = Math.min(stock[exactIndex], remaining);
        stock[exactIndex] -= use;
        remaining -= use;

        for (int j = 0; j < count && remaining > 0; j++) {
            int i = compatibleIndexes[j];

            if (i == exactIndex) {
                continue;
            }

            use = Math.min(stock[i], remaining);
            stock[i] -= use;
            remaining -= use;
        }

        System.out.println("Request processed successfully.");
        System.out.println("Units issued: " + units);
        System.out.println("Please verify compatibility and suitability "
                + "through qualified blood bank professionals.");
    }

    // Safely read integer input
    static int readInt() {
        while (!sc.hasNextInt()) {
            System.out.print("Please enter a valid number: ");
            sc.nextLine();
        }

        int number = sc.nextInt();
        sc.nextLine();
        return number;
    }

    public static void main(String[] args) {

        int choice;

        do {
            System.out.println("\n================================");
            System.out.println(" BLOOD BANK INVENTORY SYSTEM");
            System.out.println("================================");
            System.out.println("1. Register Donor");
            System.out.println("2. View All Donors");
            System.out.println("3. Add Blood Stock");
            System.out.println("4. View Blood Inventory");
            System.out.println("5. Find Compatible Donors");
            System.out.println("6. Request Blood");
            System.out.println("7. Exit");
            System.out.print("Enter your choice: ");

            choice = readInt();

            switch (choice) {
                case 1:
                    addDonor();
                    break;

                case 2:
                    viewDonors();
                    break;

                case 3:
                    addBloodStock();
                    break;

                case 4:
                    viewInventory();
                    break;

                case 5:
                    findDonors();
                    break;

                case 6:
                    requestBlood();
                    break;

                case 7:
                    System.out.println("Thank you for using the system!");
                    break;

                default:
                    System.out.println("Invalid choice. Try again.");
            }

        } while (choice != 7);

        sc.close();
    }
}

